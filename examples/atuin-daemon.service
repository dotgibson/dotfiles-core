# examples/atuin-daemon.service — systemd USER unit for atuin's history daemon.
#
# Copy, do not symlink (this file is a reference, not Core-managed wiring):
#     mkdir -p ~/.config/systemd/user
#     cp core/examples/atuin-daemon.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now atuin-daemon
#     loginctl enable-linger "$USER"      # optional: keep it alive outside a login session
#
# Then tell atuin to USE it, from the OS layer (os/<os>.zsh — never from Core's
# atuin/config.toml, which is identical on every machine):
#     export ATUIN_DAEMON__ENABLED=true
#
# This is the systemd half of the story only. On Alpine and macOS there is no unit at all:
# export ATUIN_DAEMON__ENABLED=true together with ATUIN_DAEMON__AUTOSTART=true and let atuin
# start and health-check the daemon itself. See footnote 20 in PORTING-MATRIX.md.
#
# Socket-activation variant: add an atuin-daemon.socket with ListenStream=%t/atuin.sock,
# enable THAT instead of this service, and set systemd_socket = true. It buys on-demand
# start, but it is also the one shape Core's shell-side guard cannot protect: the socket
# keeps ACCEPTING while the daemon behind it is dead, which is the indefinite-freeze state
# in atuinsh/atuin#3382. It is mutually exclusive with autostart. Prefer this plain
# always-running service.

[Unit]
Description=atuin shell-history daemon
Documentation=https://docs.atuin.sh/reference/daemon/

[Service]
# `atuin daemon` runs in the foreground and is its own supervisor target. The binary lives
# in a DIFFERENT place depending on how the box got it, and a user unit inherits NONE of your
# shell PATH, so a hard-coded absolute path makes this file copy-paste-broken (203/EXEC) on
# whichever repos guessed wrong. All three real locations are listed below:
#   %h/.atuin/bin   atuin's OWN installer (`curl -fsSL https://setup.atuin.sh | sh`) — this is
#                   what dotfiles-Fedora's bootstrap runs, and atuin's install.sh hard-codes
#                   $HOME/.atuin/bin. It is FIRST because it is the one Core's own PATH setup
#                   (zsh/00-tools.zsh adds only ~/.local/bin) does not cover.
#   %h/.local/bin   where the fleet's bootstrap puts binary-distributed tools (starship, mise,
#                   carapace, Core's clip helpers).
#   /usr/bin        where a distro packages it (Arch, openSUSE, Gentoo, Alpine).
# Then a one-line `sh -c`: sh EXECs atuin, so nothing lingers and the daemon still owns the
# main PID. Replace both lines with a literal path if you prefer.
#
# WHY THE PROBE: `atuin daemon` is deprecated in favour of `atuin daemon start` (18.19.0
# warns on every start), but the subcommand does not exist on older builds, and this file is
# copy-pasted onto machines whose atuin we do not control. Picking either spelling outright
# breaks one of them — and breaking it is not loud: with the daemon enabled and unreachable,
# atuin exits 0, prints a well-formed history id, writes nothing to stderr, and DISCARDS the
# entry. A failed ExecStart plus Restart=on-failure below is therefore an indefinite
# 3-second restart loop with nothing ever listening. Core shells survive it — zsh/00-tools.zsh's
# _core_atuin_daemon_guard probes the socket at the first prompt and again, throttled, for the
# life of the shell, and forces the daemon off for good the first time a connect fails so atuin
# writes SQLite directly; a session that was healthy and lost the daemon says so once, then
# degrades quietly. Anyone using this unit WITHOUT that guard — i.e. most people copying this
# file — has no such backstop at all, and every command runs into the loop unrecorded.
#
# So ask the binary which spelling it has, then exec it. Note the probe cannot be folded
# into `exec A || exec B`: once exec succeeds the process is REPLACED, so a non-zero exit
# from atuin can never reach the `||`. It also cannot be `atuin daemon --help`, which exits
# 0 on both spellings and so proves nothing. The probe costs one short-lived fork at unit
# start, not per command.
Environment=PATH=%h/.atuin/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/sh -c 'if atuin daemon start --help >/dev/null 2>&1; then exec atuin daemon start; else exec atuin daemon; fi'
Restart=on-failure
RestartSec=3
# The daemon exists to remove SQLite lock contention, not to add it back: one instance.
KillMode=mixed

[Install]
WantedBy=default.target
