# GENERATED by dotfiles-core scripts/gen-hero-tape.sh — DO NOT EDIT.
#   body:     dotfiles-core assets/hero.tape.in
#   per-repo: dotfiles-core assets/hero-repos.txt (row: .)
#   colours:  dotfiles-core theme/palette.toml
# Edit the body or the registry, then run `make gen-hero-tape` in dotfiles-core.
#
# Render:  vhs assets/demo.tape      # writes assets/demo.gif — commit it
# Needs:   vhs, and a Nerd Font installed locally (eza/starship icons).

Output assets/demo.gif

Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font"   # must be a Nerd Font, or icons break
Set FontSize 20
Set Width 1200
Set Height 700
Set Padding 20
Set Theme { "name": "Tokyo Night storm (dotfiles-core)", "background": "#24283b", "foreground": "#c0caf5", "selection": "#2e3c64", "cursor": "#c0caf5", "black": "#1d202f", "red": "#f7768e", "green": "#9ece6a", "yellow": "#e0af68", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#7dcfff", "white": "#a9b1d6", "brightBlack": "#414868", "brightRed": "#db4b4b", "brightGreen": "#9ece6a", "brightYellow": "#e0af68", "brightBlue": "#7aa2f7", "brightMagenta": "#bb9af7", "brightCyan": "#7dcfff", "brightWhite": "#c0caf5" }
Set TypingSpeed 45ms

# --- silent setup: land on a clean prompt, with nothing that can page ---
# CORE_NO_PAGER and GIT_PAGER are what let the tour drop the four `q` keystrokes
# the first cut needed: a pager costs a Type, an Enter and two Sleeps per command,
# which is most of the difference between a ~27 s clip and this one.
#
# `|| exit 1` ON THE cd IS LOAD-BEARING. This block is hidden, so a `cd` to a path that
# does not exist on the rendering box prints its error into frames nobody records and
# then films $HOME — a hero of the wrong tree, which is #698's original defect wearing a
# different hat. Exiting kills the session instead, so vhs fails visibly rather than
# producing a plausible-looking gif of the wrong directory.
Hide
Type "export CORE_NO_PAGER=1 GIT_PAGER=cat" Enter
Type "source ~/.config/zsh/.zshrc" Enter
Type "cd ~/code/dotgibson/dotfiles-core || exit 1" Enter
Type "clear" Enter
Show
Sleep 1500ms

# --- the tour: three shared marquee moments, then the one that is this repo's ---
Type "ll" Sleep 400ms Enter Sleep 1600ms             # eza — icons + git status
Type "cat README.md" Sleep 400ms Enter Sleep 1600ms  # bat — syntax highlighting
Type "glog -8" Sleep 400ms Enter Sleep 1600ms        # git log, graphed and decorated
Type "core status" Sleep 400ms Enter Sleep 2500ms    # the provenance panel — version, live layers, tool health
Sleep 1s
