new file mode 100644
index 0000000..f89e270
--- /dev/null
+++ w/os/opensuse.microos.capabilities
@@ -0,0 +1,41 @@
+# os/opensuse.microos.capabilities — the TRANSACTIONAL edition's declaration (MicroOS,
+# Aeon, Kalpa). Selected by bootstrap.sh's bootstrap_wire_pre_loader when
+# transactional-update exists and /usr is read-only; os/opensuse.capabilities (Tumbleweed)
+# and os/opensuse.leap.capabilities stay as they are. Read by Core's 02-capabilities.zsh;
+# validated by core/scripts/check-capabilities.sh.
+#
+# What differs from the Tumbleweed declaration, and why (measured on MicroOS 20260911):
+#   · `zypper in` is refused ("Transactional system detected", rc 5); install and upgrade
+#     go through transactional-update into a NEW snapshot, live after PKG_APPLY.
+#   · transactional-update takes its options BEFORE the command, so `up -y` cannot append
+#     -n: no PKG_ASSUME_YES. No PKG_UPGRADE_PARTIAL: a snapshot is all-or-nothing.
+#   · no MAINT_UNATTENDED_UPGRADE: MicroOS ships its own transactional-update.timer and a
+#     health-checker rollback; Core's runner must not run a second one beside it.
+#   · the pending count stays zypper's read-only list-updates (measured: exit 0 on the
+#     running snapshot); transactional-update has no check mode.
+
+PROVISIONER=transactional
+
+# ── package-manager verbs (required) ──────────────────────────────────────────
+PKG_REFRESH=sudo zypper refresh
+PKG_UPGRADE=sudo transactional-update dup
+PKG_INSTALL=sudo transactional-update -n pkg in
+PKG_REMOVE=sudo transactional-update -n pkg rm
+PKG_SEARCH=zypper se
+PKG_OWNS=zypper se --provides
+PKG_COUNT_PENDING=zypper -q list-updates
+PKG_PENDING_MATCH=^v[[:space:]]
+PKG_PENDING_FS=|
+PKG_PENDING_FIELD=3
+
+# ── the staged change becomes live ────────────────────────────────────────────
+PKG_APPLY=sudo systemctl reboot
+# R5: a closed snapshot leaves /run/reboot-needed; a user can test it (measured).
+PKG_APPLY_PENDING=test -e /run/reboot-needed
+
+# ── scheduler (required) ──────────────────────────────────────────────────────
+SCHEDULER=systemd
+SCHEDULER_UNIT_DIR=~/.config/systemd/user
+
+# ── optional ──────────────────────────────────────────────────────────────────
+TOOLS_OPTIN=lnav hyperfine watchexec shellcheck shfmt ouch git-absorb jnv gping uv
