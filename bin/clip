#!/usr/bin/env bash
# core/bin/clip — cross-OS "copy to clipboard". Reads stdin, copies it.
# ONE clipboard implementation, shared by zsh (pbcopy), tmux (copy-pipe), and
# nvim (clipboard provider).
# Detection order: WSL -> macOS -> Wayland -> X11 -> OSC 52.
# Usage: … | clip [--sensitive]      (CLIP_SENSITIVE=1 is the same as --sensitive)
set -euo pipefail

# ── --sensitive: "this is a secret; leave it nowhere but the clipboard" (#690) ─
# The real backends (clip.exe/pbcopy/wl-copy/xclip/xsel) put the payload on the system
# clipboard and nothing else, so the flag changes nothing for them. It exists for the OSC 52
# last resort UNDER TMUX, where the plain path leaves a copy of the payload in a tmux paste
# buffer that anything with the socket can read back (`tmux show-buffer`) — see
# _osc52_copy. optoken pipes a live TOTP through here with this flag; nothing else in Core
# sets it, and the default path is byte-for-byte what it was before the flag existed.
#
# Parsed with a loop over "$@" rather than getopts: this is the nvim/tmux hot path (see
# below) and the loop is free when there are no arguments, which is every caller but
# optoken. An unknown argument is refused rather than ignored — `clip somefile` used to
# hang reading stdin, which is not a behaviour worth preserving.
_sensitive=""
[[ -n "${CLIP_SENSITIVE:-}" && "${CLIP_SENSITIVE}" != 0 ]] && _sensitive=1
for _arg in "$@"; do
  case "$_arg" in
    --sensitive) _sensitive=1 ;;
    *)
      echo "clip: unknown argument '$_arg'" >&2
      echo "  usage: … | clip [--sensitive]" >&2
      exit 2
      ;;
  esac
done

# Hot path: nvim/tmux re-exec this on EVERY yank/paste (the clipboard provider runs
# with cache_enabled=0 by design — see nvim clipboard.lua). So the WSL probe reads
# /proc/version with the `$(<file)` bash builtin + a glob match instead of forking a
# `grep` per invocation — on ordinary (non-WSL) Linux that grep ran every single time.
# nocasematch makes the glob case-insensitive; CLIP_PROC_VERSION lets the test suite
# point the probe at a fixture instead of the host's real /proc/version (hermetic).

# ── OSC 52: the last resort, and the only one that works over plain SSH ───────
# A headless box reached only by ssh has no Wayland, no X11 and no clip.exe, so every
# branch below used to fall through to an error — which meant `pbcopy`, tmux's
# copy-pipe and nvim's "+y were all dead on exactly the machines where copying out of
# the terminal matters most. OSC 52 is the terminal's own answer: write the payload as
# an escape sequence and the TERMINAL EMULATOR puts it on the clipboard of the machine
# you are sitting at, with nothing installed on the remote end.
#
# Deliberately LAST. A real backend is bidirectional and does not depend on terminal
# support, so wl-copy/xclip/pbcopy win wherever they can actually work.
#
# It goes to /dev/tty, never stdout: `clip` is used in pipelines (`… | clip`) and as
# nvim's provider, so stdout may be a pipe, a file, or /dev/null — writing the escape
# there would corrupt the caller's data and copy nothing. CLIP_TTY overrides the target
# for the test suite, the same seam CLIP_PROC_VERSION provides above.
#
# Inside tmux, a PANE process needs no special handling: Core's tmux.conf sets
# `set-clipboard on`, so tmux consumes the pane's OSC 52 and forwards it to the outer
# terminal itself. No DCS passthrough wrapping — that is for sequences tmux does NOT
# understand, and wrapping one it does understand would break it.
#
# The one binding that names `clip`, however, is NOT a pane process. tmux.reset.conf binds
#     bind -T copy-mode-vi y  send -X copy-pipe-and-cancel "clip"
# and `copy-pipe` runs its command through tmux's job_run() — a child of the DAEMONIZED
# SERVER, which has called setsid() and so has no controlling terminal, and whose stderr
# is dup2'd to /dev/null. The /dev/tty open below therefore fails with ENXIO, the error
# message goes nowhere, and `clip` exits 1 silently: the OSC 52 branch is UNREACHABLE from
# that binding.
#
# Prefix-`y` still copies today only because window_copy_copy_pipe() also calls
# window_copy_copy_buffer(), which under `set-clipboard on` emits its OWN OSC 52 from the
# server side. That is tmux covering for us, not this file working — so the moment
# `set-clipboard` goes off, or tmux is built without it, copy-out dies on exactly the
# headless box this fallback exists for, with a comment here claiming it is handled.
#
# Hence the tmux arm in _osc52_copy: `tmux load-buffer -w -` reaches the client from the
# SERVER side and needs no tty at all — precisely what the copy-pipe child lacks. It stays
# a fallback rather than a first choice, because a pane process should keep taking the
# /dev/tty path, which works whether or not `set-clipboard` is on.
_osc52_copy() {
  local tty="${CLIP_TTY:-/dev/tty}" b64

  # `base64 | tr -d '\n'` and not `base64 -w0`: -w is GNU-only and macOS's BSD base64
  # rejects it. The payload must be one unbroken line — a newline inside the sequence
  # terminates it early and the terminal copies a truncated value.
  b64="$(base64 | tr -d '\n')" || {
    echo "clip: base64 failed — nothing copied" >&2
    return 1
  }

  # Terminals cap the sequence length (xterm's default is around 100 KB of base64) and
  # the usual failure is a SILENT drop: the escape is ignored and the user believes the
  # copy worked. Warn rather than refuse — the limit is per-terminal and some are much
  # more generous, so the copy may well succeed.
  if ((${#b64} > 100000)); then
    echo "clip: ${#b64} bytes of base64 — many terminals silently drop an OSC 52 payload this large, so the copy may not have landed" >&2
  fi

  # `c` is the clipboard selection (as opposed to `p`, primary). BEL terminates rather
  # than ST: both are legal, BEL is accepted by more terminals.
  #
  # ATTEMPT the write rather than probing with `[[ -w ]]` first. When a process has no
  # controlling terminal (cron, a daemon, anything setsid'd) /dev/tty still EXISTS and
  # still passes the permission test — opening it is what fails, with ENXIO. A probe
  # would report success and then lose the copy. This also avoids the TOCTOU gap
  # between probing and writing.
  #
  # One caveat stated rather than silently accepted: writing to a character device is
  # LINE-buffered and this sequence contains no newline by construction, so a payload past
  # BUFSIZ (~4 KB of base64, ~3 KB of copied text) leaves as several write() calls on a tty
  # the foreground TUI also owns. If nvim redraws between two of them the sequence splits
  # and the terminal copies a partial value. nvim blocks on the provider job, so the window
  # is small — but it is real, and it grows with yank size.
  #
  # --sensitive under tmux never takes this write. With Core's own `set-clipboard on`
  # (tmux.conf) the pane's OSC 52 is not merely forwarded: tmux's input_osc_52() ALSO
  # paste_add()s the decoded payload as an unnamed buffer, so the "write the escape straight
  # to the tty" idea from #690 would leave the secret exactly where the flag promises it will
  # not be. The sensitive arm below routes around tmux's parser instead.
  if [[ -n "$_sensitive" && -n "${TMUX:-}" ]]; then
    _osc52_sensitive_tmux "$b64" "$tty"
    return
  fi
  if { printf '\033]52;c;%s\a' "$b64" >"$tty"; } 2>/dev/null; then
    return 0
  fi

  # The write failed, which under tmux means the copy-pipe case above: no controlling
  # terminal, so it could never have worked. Hand the payload to the tmux SERVER instead —
  # `-w` (tmux >= 3.2) makes it set the outer terminal's clipboard as well as holding the
  # buffer locally. tmux.conf already targets >= 3.4 features, so the floor is met.
  #
  # The payload is reconstructed by decoding $b64 rather than being stashed on the way in.
  # Holding the raw bytes would mean either a shell variable — not binary-safe, since
  # command substitution strips trailing newlines and cannot carry a NUL — or a temp file,
  # which would add mktemp/cat/rm to a path that runs on the most minimal boxes we support
  # and would put a TOTP (optoken pipes one through here) on disk. Decoding costs one more
  # process on an already-failed path and keeps both problems away. `-d` is accepted by
  # GNU, busybox and BSD base64 alike; macOS never reaches here anyway, because the Darwin
  # branch below execs pbcopy.
  if [ -n "${TMUX:-}" ] && command -v tmux >/dev/null 2>&1 \
    && printf '%s' "$b64" | base64 -d 2>/dev/null | tmux load-buffer -w - 2>/dev/null; then
    return 0
  fi

  _osc52_no_backend "$tty"
}

_osc52_no_backend() {
  echo "clip: no clipboard backend, and no terminal at $1 for the OSC 52 fallback" >&2
  echo "  (install wl-clipboard or xclip, or run this from a terminal session)" >&2
  return 1
}

# ── the sensitive arm under tmux (#690) ───────────────────────────────────────
# Two ways to reach the outer terminal's clipboard without leaving the payload in a tmux
# paste buffer, tried in order of how completely they close the window:
#
#   1. DCS passthrough — `ESC P tmux; <OSC 52 with its ESC doubled> ESC \`. tmux hands the
#      inner sequence to the outer terminal verbatim and its own OSC 52 parser never sees
#      it, so NO buffer is ever created. Needs the pane's `allow-passthrough` to be `on`
#      (visible panes only) or `all`; tmux's default is `off`, in which case the DCS is
#      dropped on the floor, silently — which is why it is probed rather than assumed.
#   2. A NAMED transient buffer — `tmux load-buffer -w -b <name> -` followed at once by
#      `tmux delete-buffer -b <name>`. `-w` is what puts the payload on the outer clipboard
#      (server-side OSC 52, honouring `set-clipboard`); the delete is the whole point. Both
#      are socket round-trips executed in order, so the buffer exists for the gap between
#      them and no longer: narrowed, not closed, and said so on stderr at the moment it
#      matters. Named so that the delete can never take out a buffer that is not ours — a
#      bare `delete-buffer` removes the MOST RECENT buffer, which is a race against tmux
#      reading the pane and against every other client on the socket.
#
# Neither arm reaches past ONE tmux: under nested tmux the outer server parses whatever the
# inner one forwards (a passthrough DCS, or the OSC 52 that `-w` emits), and with its own
# `set-clipboard on` it keeps a buffer this process cannot see, let alone delete.
#
# If the buffer cannot be deleted, this is a FAILURE: the payload is on the clipboard, but
# the one thing --sensitive promised is untrue, so exit 1 with the exact command to fix it
# rather than let the caller print "sent".
_osc52_sensitive_tmux() {
  local b64="$1" tty="$2" name passthrough
  if ! command -v tmux >/dev/null 2>&1; then
    _osc52_no_backend "$tty"
    return
  fi

  # `-p` pane options, `-A` walk the pane→window→global inheritance (a bare `set -g`
  # lives at the global-window level, which `-p` alone does not show), `-q` so a tmux
  # older than 3.3 — no such option — prints nothing and lands on arm 2.
  passthrough="$(tmux show-options -pAqv allow-passthrough 2>/dev/null || true)"
  case "$passthrough" in
    on | all)
      # BEL still terminates the inner OSC; inside a DCS, C0 controls are collected as
      # payload, so the outer terminal receives the identical sequence the non-tmux path
      # emits. A tty that cannot be opened (no controlling terminal) falls to arm 2.
      # \134 is the ST's backslash as an octal escape — a literal `\\` at the end of a
      # single-quoted format reads as an escaped quote to shellcheck (SC1003).
      if { printf '\033Ptmux;\033\033]52;c;%s\a\033\134' "$b64" >"$tty"; } 2>/dev/null; then
        return 0
      fi
      ;;
  esac

  name="clip-sensitive-$$"
  # A signal in the instant between the two commands (Ctrl-C, a closed ssh session's HUP)
  # must not strand the buffer: the traps delete it on the way out. $name is expanded NOW,
  # deliberately — the handler must name this buffer even if the variable is gone.
  # shellcheck disable=SC2064
  trap "tmux delete-buffer -b '$name' 2>/dev/null; trap - EXIT; exit 1" INT TERM HUP
  # shellcheck disable=SC2064
  trap "tmux delete-buffer -b '$name' 2>/dev/null" EXIT
  if printf '%s' "$b64" | base64 -d 2>/dev/null | tmux load-buffer -w -b "$name" - 2>/dev/null; then
    if tmux delete-buffer -b "$name" 2>/dev/null; then
      trap - EXIT INT TERM HUP
      echo "clip: could not pass the escape through tmux to the outer terminal (allow-passthrough off, or no tty), so the copy went through a tmux buffer (created and deleted at once; readable on the tmux socket for that instant — \`set -g allow-passthrough on\` avoids the buffer entirely)" >&2
      return 0
    fi
    # The EXIT trap stays armed: one more attempt on the way out costs nothing.
    echo "clip: copied, but could NOT delete the transient tmux buffer holding it — run: tmux delete-buffer -b $name" >&2
    return 1
  fi
  trap - EXIT INT TERM HUP
  echo "clip: tmux load-buffer failed — nothing copied" >&2
  return 1
}

shopt -s nocasematch
_pv=""
[[ -z "${WSL_DISTRO_NAME:-}" && -r "${CLIP_PROC_VERSION:-/proc/version}" ]] && _pv="$(<"${CLIP_PROC_VERSION:-/proc/version}")"
if [[ -n "${WSL_DISTRO_NAME:-}" || "$_pv" == *microsoft* || "$_pv" == *wsl* ]]; then
  exec clip.exe # WSL -> Windows clipboard
elif [[ "$(uname -s)" == "Darwin" ]]; then
  exec pbcopy # macOS native
elif [[ -n "${WAYLAND_DISPLAY:-}" ]] && command -v wl-copy >/dev/null; then
  exec wl-copy # Wayland
# The DISPLAY guards mirror the WAYLAND_DISPLAY one above, and they are what make the
# OSC 52 fallback reachable in the case that actually happens: a desktop distro has
# xclip installed as a dependency of something else, so `command -v xclip` succeeds
# over ssh — but with no DISPLAY the exec just fails, and it failed INSTEAD of falling
# through to a fallback that would have worked.
elif [[ -n "${DISPLAY:-}" ]] && command -v xclip >/dev/null; then
  exec xclip -selection clipboard # X11
elif [[ -n "${DISPLAY:-}" ]] && command -v xsel >/dev/null; then
  exec xsel --clipboard --input # X11 fallback
else
  _osc52_copy
fi
